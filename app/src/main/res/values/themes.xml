<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app window; Compose paints everything inside it with the chosen theme. -->
    <style name="Theme.WaveTop" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/wt_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown while WaveTop starts (androidx.core.splashscreen). -->
    <style name="Theme.WaveTop.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wt_logo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.WaveTop</item>
    </style>
</resources>
